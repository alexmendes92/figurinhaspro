{
  "_comment": "Permissions do plugin p8-master. Compõe com permissions globais (~/.claude/settings.json) e do projeto (P8-FigurinhasPro/.claude/settings.json) — não substitui.",
  "permissions": {
    "allow": [
      "Read",
      "Write",
      "Edit",
      "Bash(npm run *)",
      "Bash(npx *)",
      "Bash(npx prisma *)",
      "Bash(npx tsc *)",
      "Bash(npx next *)",
      "Bash(npx vitest *)",
      "Bash(npx biome *)",
      "Bash(stripe listen *)",
      "Bash(stripe trigger *)",
      "Bash(stripe logs *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git branch *)",
      "Bash(git checkout *)",
      "Bash(ls *)",
      "Bash(pwd)",
      "Bash(jq *)",
      "Bash(rg *)",
      "Bash(fd *)",
      "Bash(bash scripts/*)",
      "Bash(pwsh -File scripts/*)",
      "Bash(python scripts/*)",
      "Bash(bash tests/*)",
      "Bash(pwsh -File tests/*)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(npx vercel deploy*)",
      "Bash(npx prisma db push*)",
      "Bash(npx prisma migrate*)",
      "Bash(gh pr *)",
      "Bash(rm *)",
      "Bash(stripe customers *)",
      "Bash(stripe subscriptions *)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/secrets/**)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Bash(rm -rf*)",
      "Bash(sudo*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(npx prisma migrate reset*)"
    ]
  }
}
