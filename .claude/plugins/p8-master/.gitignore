# Plugin P8-MASTER — gitignore local

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Pytest
.pytest_cache/

# Estado do plugin (cache local, nao compartilhado)
state/sessions/*.jsonl
state/aggregates/*.json
state/last-update.json
state/last-gap-check.log
state/rejections.jsonl
state/timeouts.jsonl
!state/sessions/.gitkeep
!state/aggregates/.gitkeep

# Scripts auto-gerados (criados por skill-creator) — versionar caso a caso
scripts/auto-generated/*.PROPOSED

# Output local de testes
tests/results/
.coverage
coverage.xml

# Logs locais
*.log
