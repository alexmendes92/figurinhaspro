{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(*)",
      "Edit(*)",
      "Write(*)",
      "Read(*)",
      "Glob(*)",
      "Grep(*)",
      "NotebookEdit(*)",
      "WebFetch(*)",
      "WebSearch(*)",
      "Read(//c/tmp/**)"
    ],
    "defaultMode": "bypassPermissions"
  },
  "enabledPlugins": {
    "vercel@claude-plugins-official": true,
    "p8-master@p8-local": true
  }
}
